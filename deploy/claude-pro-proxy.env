# Port the claude-pro-proxy server listens on.
#
# Single source of truth for the port. This file is rsynced to the mini on
# every deploy and read in two places:
#   - claude-pro-proxy.service, via
#     `EnvironmentFile=-/srv/claude-pro-proxy/deploy/claude-pro-proxy.env`
#   - the "Health check" step in .github/workflows/mac-mini.yml
#
# Secrets (API_KEY, ...) are NOT here — they live in /etc/claude-pro-proxy/env
# on the mini (untracked, root:andrewsaunders 0640) and are loaded first, so
# this file's PORT overrides any stale value there.
PORT=8001
