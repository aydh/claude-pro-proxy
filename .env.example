# Copy to .env (or run ./generate_api_key.py to create one automatically).
# Bind default is 127.0.0.1 - change HOST if you want LAN access.

# Required. Clients must send Authorization: Bearer <API_KEY>.
API_KEY=sk-proxy-change-me

# Optional. Defaults shown.
# HOST=127.0.0.1
# PORT=8001
# CLAUDE_BIN=claude
# DEFAULT_MODEL=claude-sonnet-4-6
# LOG_LEVEL=INFO
# LOG_PROMPTS=false
# CLAUDE_PROXY_HOME=~/.claude-proxy
# CLI_TIMEOUT_SECONDS=300
# MAX_REQUEST_BYTES=10485760
# MAX_SYSTEM_PROMPT_BYTES=98304
# SESSION_CACHE_SIZE=256
# SESSION_CACHE_TTL_SECONDS=3600
# CLAUDE_MODELS=claude-opus-4-7,claude-sonnet-4-6
# MAX_CONCURRENT_CLI=2
